{
  "name": "cocoda",
  "version": "1.12.3",
  "jskos-api": "^1.0 || ^2.0",
  "description": "Cocoda Mapping Tool",
  "author": "Jakob Voß <jakob.voss@gbv.de>",
  "contributors": [
    "Rodolfo Marraffa <rodolfo.marraffa@gbv.de>",
    "Stefan Peters <stefan.peters@gbv.de>"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "_prepare": "./bin/prepare.sh",
    "dev": "npm run _prepare; vite",
    "build": "./build/build.sh",
    "build-all": "./build/build-all.sh",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:watch": "vitest --config vitest.config.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:e2e:ui": "playwright test --config playwright.config.js --ui",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "loc": "cloc $(git ls-files)",
    "build-info": "./build/build-info.js > ./build/build-info.json",
    "manual": "make -BC docs",
    "manual-pdf": "make -BC docs pdfs",
    "release:patch": "./bin/release.sh patch",
    "release:minor": "./bin/release.sh minor",
    "release:major": "./bin/release.sh major",
    "kos-types": "wget http://api.dante.gbv.de/voc/top?uri=http://w3id.org/nkos/nkostype -O config/kos-types.json",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "**/*.{js,vue}": [
      "eslint"
    ],
    "**/*.json": [
      "./bin/format-json.js"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.1.0",
    "cocoda-sdk": "~3.8.3",
    "css-element-queries": "^1.2.3",
    "file-saver": "^2.0.5",
    "gbv-login-client": "^2.0.1",
    "jskos-tools": "^1.3.0",
    "jskos-vue-tabs": "^0.1.8",
    "json-format-highlight": "^1.0.4",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "vue": "^3.5.42",
    "vue-flexible-table": "^1.1.0",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4",
    "vue-scrollto": "^2.20.0",
    "vue-virtual-scroller": "^3.0.5",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-legacy": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "~10.5.0",
    "eslint-config-gbv": "~2.7",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.6.6",
    "less-loader": "^13.0.0",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "terser": "^5.48.0",
    "vite": "^7.3.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
